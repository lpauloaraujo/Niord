<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon_app"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon_app_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Niord"
        android:forceDarkAllowed="false"
        android:usesCleartextTraffic="true" >
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Niord.Splash"
            tools:targetApi="26">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PosEmergenciaActivity" />
        <activity android:name=".PosPoliciaActivity" />
        <activity
            android:name=".CadastroActivity"
            android:windowSoftInputMode="adjustResize"
            >
        </activity>
        <activity
            android:name=".OtpActivity"
            android:windowSoftInputMode="adjustResize" >
        </activity>
        <activity
            android:name=".OnboardingActivity"
            android:screenOrientation="portrait" >
        </activity>
        <activity
            android:name=".ConfiguracaoActivity"
            android:windowSoftInputMode="adjustResize" >
        </activity>

        <activity
            android:name=".AccountSecurityActivity"
            android:windowSoftInputMode="adjustResize" >
        </activity>
        <activity
            android:name=".AccountDataActivity"
            android:windowSoftInputMode="adjustResize" >
        </activity>
        <activity
            android:name=".ContatosEmergenciaActivity"
            android:windowSoftInputMode="adjustResize" >
        </activity>
        <activity
            android:name=".FloatingButtonCustomizationActivity"
            android:windowSoftInputMode="adjustResize" >
        </activity>
        <service
            android:name=".VigiaService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".FloatingOverlayService"
            android:foregroundServiceType="location"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
